rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-owned documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is an admin
    // Admins are defined by their role in the users collection OR by specific emails
    function isAdmin() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          request.auth.token.email == "authomia.agency@gmail.com" ||
          request.auth.token.email == "usuario@gmail.com" ||
          request.auth.token.email == "luiseduardocerron.ec@gmail.com" ||
          request.auth.token.email == "cerronbarrial@gmail.com" ||
          request.auth.token.email == "admin@labsnatural.com"
        );
    }

    // ===============================================================
    // Collections
    // ===============================================================

    // Users Collection
    match /users/{userId} {
      // Users can read their own profile. Admins can read all profiles.
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile, but they MUST be created as 'user' (cannot self-assign 'admin')
      allow create: if isAdmin() || (isAuthenticated() && isOwner(userId)
                    && request.resource.data.role == 'user');
                    
      // Users can update their own profile, but CANNOT change their role or points. Admins can update anything.
      allow update: if isAdmin() ||
                    (isOwner(userId)
                     && request.resource.data.role == resource.data.role
                     && request.resource.data.points == resource.data.points);
                     
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Reports Collection
    match /reports/{reportId} {
      // Anyone can read 'verified' reports (for the public map). 
      // Users can read their own reports (pending/denied). Admins can read all.
      allow read: if resource.data.status == 'verified' || isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      
      // Authenticated users can create reports, but they MUST be 'pending' and linked to their own user_id.
      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.status == 'pending';
                    
      // Only admins can update reports (e.g., to change status to 'verified' or 'denied')
      allow update: if isAdmin();
      
      // Only admins can delete reports
      allow delete: if isAdmin();
    }

    // Guides Collection (Educational Content)
    match /guides/{guideId} {
      // Anyone can read the guides
      allow read: if true;
      
      // Only admins can create, update, or delete guides
      allow create, update, delete: if isAdmin();
    }

    // Groups Collection (Categories for Guides)
    match /groups/{groupId} {
      // Anyone can read the groups
      allow read: if true;
      
      // Only admins can create, update, or delete groups
      allow create, update, delete: if isAdmin();
    }

    // Redemptions Collection (Point Exchanges)
    match /redemptions/{redemptionId} {
      // Users can read their own redemptions. Admins can read all.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      
      // Users can create a redemption request, must be 'pending' and linked to their ID.
      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.status == 'pending';
                    
      // Only admins can update (approve/deny) or delete redemptions
      allow update, delete: if isAdmin();
    }

    // Messages Collection (Contact Form)
    match /messages/{messageId} {
      // Users can read their own messages. Admins can read all.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      
      // Users can create a message, linked to their ID.
      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid;
                    
      // Only admins can update (mark as read) or delete messages
      allow update, delete: if isAdmin();
    }
  }
}
